{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/hcp/0.1/assertion.schema.json",
  "title": "HCP Assertion",
  "type": "object",
  "required": ["hcp", "id", "type", "source", "authority", "status", "visibility"],
  "properties": {
    "hcp": {"type": "string"},
    "id": {"type": "string", "minLength": 1},
    "type": {
      "type": "string",
      "enum": [
        "fact", "belief", "value", "principle", "preference",
        "boundary", "goal", "aspiration", "identity", "relationship",
        "experience", "observation"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["human", "ai", "import", "derived"]
    },
    "authority": {
      "type": "string",
      "enum": ["authoritative", "proposed", "rejected", "archived"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "pending", "rejected", "archived"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "valid_from": {"type": "string", "format": "date"},
    "valid_until": {"type": ["string", "null"], "format": "date"},
    "supersedes": {"type": ["string", "null"]},
    "visibility": {
      "type": "string",
      "enum": ["public", "private", "sensitive", "restricted"]
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "derived_from": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
